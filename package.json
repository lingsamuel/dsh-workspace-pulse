{
  "name": "dsh-workspace-pulse",
  "version": "0.1.0",
  "description": "DeepSeek Harness Web 折叠工作区的运行会话计数",
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["src/host.js", "dist/", "cordis.patch.yml", "manual/"],
  "keywords": ["dsh-plugin", "deepseek-harness", "workspace"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "esbuild test/activity.test.js --bundle --platform=node --format=esm --outfile=.runtime/activity.test.mjs && node --test .runtime/activity.test.mjs",
    "test:web": "node test/web.mjs",
    "package:plugin": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-session-controller": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-text-search": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.3-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.3-alpha.2",
    "esbuild": "0.27.4",
    "playwright-core": "1.64.1"
  }
}
